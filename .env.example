# 调试开关：true 时离线模拟云端 API；填入真实密钥后改为 false
MOCK_EXTERNAL_APIS=true

# 首次初始化空库时是否注入 5 名演示临界生（正式导入真实班级时可设为 false）
SEED_DEMO_DATA=true

# 单教师工作台访问密码（公网部署必改）
TEACHER_ACCESS_PASSWORD=math2026

# DSH MCP / 批处理桥接鉴权密钥（公网部署必改随机长串）
MCP_AUTH_TOKEN=dev-mcp-token-change-me

# DeepSeek API（主力推理与出题）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 阿里云百炼 DashScope（母题向量与重排）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
EMBEDDING_MODEL=text-embedding-v4
RERANK_MODEL=qwen3-rerank

# 腾讯云文档智能 - 试题批改 (Agent版)
TENCENTCLOUD_SECRET_ID=your_secret_id
TENCENTCLOUD_SECRET_KEY=your_secret_key
TENCENTCLOUD_REGION=ap-guangzhou

# 服务基础配置
APP_HOST=0.0.0.0
APP_PORT=8000
SQLITE_DB_PATH=data/app.db
